{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://photobooth-cache-demo-1per.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://photobooth-cache-demo-1per.onrender.com/health"
    },
    {
      "source": "/ws",
      "destination": "https://photobooth-cache-demo-1per.onrender.com/ws"
    },
    {
      "source": "/((?!api/|health|ws).*)",
      "destination": "/index.html"
    }
  ]
}
