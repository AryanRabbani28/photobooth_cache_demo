{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "installCommand": "npm install --prefix apps/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://photobooth-cache-demo.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://photobooth-cache-demo.onrender.com/health"
    },
    {
      "source": "/ws",
      "destination": "https://photobooth-cache-demo.onrender.com/ws"
    },
    {
      "source": "/((?!api/|health|ws).*)",
      "destination": "/index.html"
    }
  ]
}
